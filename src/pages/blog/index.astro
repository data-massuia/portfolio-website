---
/**
 * Blog Index Page
 *
 * Lists all published blog posts in reverse chronological order.
 * This is the "heart" of the site — the learning journal.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

// Get all published (non-draft) posts, newest first
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="Blog"
  description="Douglas's learning journal — documenting the journey from beginner to developer through vibe coding, project breakdowns, and honest reflections."
>
  <div class="mx-auto max-w-[var(--content-max-width)] px-6 py-16">
    <!-- Page Header -->
    <h1 class="mb-4 text-3xl font-bold text-[var(--text-heading)] md:text-4xl">
      Blog
    </h1>
    <div class="mb-4 h-1 w-16 rounded bg-[var(--accent)]"></div>
    <p class="mb-12 text-[var(--text-secondary)]">
      My learning journal — thoughts, tutorials, project breakdowns, and honest
      reflections on the journey from zero to full-stack.
    </p>

    <!-- Posts List -->
    {posts.length > 0 ? (
      <div class="space-y-4">
        {posts.map((post) => (
          <BlogPostCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            tags={post.data.tags}
            slug={post.id}
            body={post.body}
          />
        ))}
      </div>
    ) : (
      <p class="text-[var(--text-secondary)]">
        No posts yet — check back soon! I'm working on my first entry.
      </p>
    )}

    <!-- RSS link -->
    <div class="mt-12 flex items-center gap-2 text-sm text-[var(--text-secondary)]">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
      </svg>
      <a href="/blog/rss.xml" class="text-[var(--accent)] transition-opacity hover:opacity-80">
        Subscribe via RSS
      </a>
    </div>
  </div>
</BaseLayout>
