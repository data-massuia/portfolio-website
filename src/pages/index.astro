---
/**
 * Homepage
 *
 * The first thing visitors see. Features:
 * - A bold, text-forward hero with name and tagline
 * - A subtle typing animation in a terminal-style element
 * - A "Currently working on" live status indicator
 * - Featured project preview
 * - A brief intro paragraph
 * - Connect CTA
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch featured projects for the homepage preview
const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => b.data.sortOrder - a.data.sortOrder)
  .slice(0, 2);
---

<BaseLayout
  title="Home"
  description="Douglas — Vibe Coder. Building my way from zero to full-stack, one project at a time. A beginner developer's portfolio and learning journal."
>
  <!-- Hero Section -->
  <section class="mx-auto max-w-[var(--page-max-width)] px-6 py-16 md:py-24">
    <div class="max-w-2xl">
      <!-- Greeting -->
      <p class="mb-4 font-mono text-sm text-[var(--accent)]">
        Hi, my name is
      </p>

      <!-- Name -->
      <h1 class="mb-2 text-4xl font-extrabold text-[var(--text-heading)] sm:text-5xl md:text-6xl">
        Douglas<span class="text-[var(--accent)]">.</span>
      </h1>

      <!-- Tagline -->
      <h2 class="mb-6 text-2xl font-semibold text-[var(--text-secondary)] sm:text-3xl md:text-4xl">
        Building in public — from zero to full-stack developer.
      </h2>

      <!-- Intro paragraph -->
      <p class="mb-8 max-w-lg text-base leading-relaxed text-[var(--text-secondary)] md:text-lg">
        I'm Douglas Massuia, a beginner developer in Vancouver documenting every step of my
        journey through <span class="text-[var(--text-primary)]">vibe coding</span> — describing what I want to build,
        studying the AI-generated code, and growing one project at a time.
      </p>

      <!-- CTA Buttons — one primary, one secondary (article: one primary CTA per page) -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/projects/"
          class="inline-flex items-center rounded-lg bg-[var(--accent)] px-6 py-3 font-medium text-[var(--bg-primary)] transition-opacity hover:opacity-90"
        >
          View My Projects
        </a>
        <a
          href="/blog/"
          class="inline-flex items-center rounded-lg border border-[var(--border)] px-6 py-3 font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          Read My Journey
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Terminal Animation -->
    <div class="mt-16 max-w-lg">
      <div class="overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)]">
        <!-- Terminal title bar -->
        <div class="flex items-center gap-2 border-b border-[var(--border)] px-4 py-2">
          <div class="h-3 w-3 rounded-full bg-red-500/60"></div>
          <div class="h-3 w-3 rounded-full bg-yellow-500/60"></div>
          <div class="h-3 w-3 rounded-full bg-green-500/60"></div>
          <span class="ml-2 font-mono text-xs text-[var(--text-secondary)]">~/douglas</span>
        </div>
        <!-- Terminal content with typing animation -->
        <div class="p-4 font-mono text-sm">
          <p class="text-[var(--text-secondary)]">
            <span class="text-[var(--accent)]">$</span> cat current-status.txt
          </p>
          <div class="mt-2" id="terminal-output">
            <p class="text-[var(--text-primary)]">
              <span class="text-[var(--accent)]">></span> Learning: Python fundamentals & game dev
            </p>
            <p class="text-[var(--text-primary)]">
              <span class="text-[var(--accent)]">></span> Building: Portfolio website (you're looking at it!)
            </p>
            <p class="text-[var(--text-primary)]">
              <span class="text-[var(--accent)]">></span> Exploring: Astro, Tailwind CSS, TypeScript
            </p>
          </div>
          <p class="mt-2 text-[var(--text-secondary)]">
            <span class="text-[var(--accent)]">$</span>
            <span class="ml-1 inline-block h-4 w-2 animate-pulse bg-[var(--accent)]"></span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Currently Working On -->
  <section class="mx-auto max-w-[var(--page-max-width)] px-6 pb-16">
    <div class="rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] p-6">
      <div class="flex items-center gap-3">
        <!-- Pulsing dot to indicate "live" -->
        <span class="relative flex h-3 w-3">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex h-3 w-3 rounded-full bg-green-500"></span>
        </span>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
          Currently Working On
        </h3>
      </div>
      <!-- TODO: Update this as you work on new things -->
      <p class="mt-3 text-lg text-[var(--text-primary)]">
        12-project game development course in Python — building classic games while learning fundamentals
      </p>
      <div class="mt-2 flex flex-wrap gap-2">
        <span class="rounded-full bg-[var(--accent-muted)] px-3 py-1 font-mono text-xs text-[var(--accent)]">
          Python
        </span>
        <span class="rounded-full bg-[var(--accent-muted)] px-3 py-1 font-mono text-xs text-[var(--accent)]">
          Pygame
        </span>
        <span class="rounded-full bg-[var(--accent-muted)] px-3 py-1 font-mono text-xs text-[var(--accent)]">
          Game Dev
        </span>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  {featuredProjects.length > 0 && (
    <section class="mx-auto max-w-[var(--page-max-width)] px-6 pb-16">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-[var(--text-heading)]">
          Featured <span class="text-[var(--accent)]">Work</span>
        </h2>
        <a
          href="/projects/"
          class="text-sm text-[var(--accent)] transition-opacity hover:opacity-80"
        >
          All projects →
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {featuredProjects.map((project) => (
          <article class="group flex flex-col rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] overflow-hidden card-hover">
            <div class="flex flex-1 flex-col p-5">
              <div class="mb-3 flex items-center justify-between">
                <h3 class="text-lg font-semibold text-[var(--text-heading)] group-hover:text-[var(--accent)] transition-colors">
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                </h3>
                <span class="rounded-full bg-green-500/20 px-2 py-0.5 text-xs font-medium text-green-400">
                  {project.data.status === 'completed' ? 'Completed' : project.data.status}
                </span>
              </div>
              <p class="mb-4 flex-1 text-sm text-[var(--text-secondary)]">{project.data.description}</p>
              {project.data.keyLearning && (
                <p class="mb-4 rounded border-l-2 border-[var(--accent)] bg-[var(--accent-muted)] px-3 py-2 text-xs text-[var(--text-secondary)]">
                  <span class="font-semibold text-[var(--accent)]">Key learning:</span> {project.data.keyLearning}
                </p>
              )}
              <div class="mb-4 flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span class="rounded-full bg-[var(--accent-muted)] px-2 py-0.5 font-mono text-xs text-[var(--accent)]">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center gap-4 border-t border-[var(--border)] pt-3 text-sm">
                <a href={`/projects/${project.id}/`} class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]">
                  Case Study
                </a>
                {project.data.repoUrl && (
                  <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]">
                    GitHub
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Quick About Section -->
  <section class="mx-auto max-w-[var(--page-max-width)] px-6 pb-16">
    <h2 class="mb-8 text-2xl font-bold text-[var(--text-heading)]">
      What is <span class="text-[var(--accent)]">Vibe Coding</span>?
    </h2>
    <div class="max-w-2xl space-y-4 text-[var(--text-secondary)]">
      <p>
        Vibe coding is a new approach to learning software development where you describe
        what you want to build in plain English, work with AI tools to generate the code,
        and then <span class="text-[var(--text-primary)]">study the output to understand how it works</span>.
      </p>
      <p>
        It's not about blindly copying code — it's about using AI as a patient tutor
        that shows you working solutions you can learn from, question, and iterate on.
        Every project I build teaches me something new.
      </p>
      <a
        href="/about/"
        class="inline-flex items-center text-[var(--accent)] transition-opacity hover:opacity-80"
      >
        Learn more about my approach
        <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Connect CTA — conversion path (article: "attention without direction produces zero leverage") -->
  <section class="mx-auto max-w-[var(--page-max-width)] px-6 pb-24">
    <div class="rounded-lg border border-[var(--accent)]/30 bg-[var(--accent-muted)] p-8 text-center">
      <h2 class="mb-3 text-xl font-bold text-[var(--text-heading)]">
        Let's Connect
      </h2>
      <p class="mb-6 mx-auto max-w-md text-[var(--text-secondary)]">
        Fellow learner, mentor, or just curious about vibe coding? I'd love to hear from you.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center rounded-lg bg-[var(--accent)] px-6 py-3 font-medium text-[var(--bg-primary)] transition-opacity hover:opacity-90"
      >
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
