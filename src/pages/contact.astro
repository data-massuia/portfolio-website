---
/**
 * Contact Page
 *
 * Simple, clean contact page with email link, social links,
 * and an inviting CTA. A contact form can be added later.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Douglas — a beginner developer in Vancouver. Open to connecting with fellow learners, mentors, and collaborators."
>
  <div class="mx-auto max-w-[var(--content-max-width)] px-6 py-16">
    <!-- Page Header -->
    <h1 class="mb-4 text-3xl font-bold text-[var(--text-heading)] md:text-4xl">
      Get in Touch
    </h1>
    <div class="mb-8 h-1 w-16 rounded bg-[var(--accent)]"></div>

    <!-- CTA Text -->
    <!-- TODO: Replace with your own message -->
    <div class="mb-12 max-w-lg space-y-4 text-[var(--text-secondary)]">
      <p>
        I'd love to connect with fellow learners, mentors, or anyone interested in
        the vibe coding journey. Whether you have advice, want to collaborate, or
        just want to say hi — don't hesitate to reach out!
      </p>
      <p>
        I'm especially interested in connecting with:
      </p>
      <ul class="ml-4 space-y-2">
        <li class="flex items-start gap-2">
          <span class="mt-1.5 text-[var(--accent)]">&#8227;</span>
          <span>Other people learning to code</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 text-[var(--accent)]">&#8227;</span>
          <span>Developers who mentor beginners</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 text-[var(--accent)]">&#8227;</span>
          <span>Anyone interested in vibe coding or AI-assisted development</span>
        </li>
      </ul>
    </div>

    <!-- Contact Links -->
    <div class="space-y-4">
      <!-- Email -->
      <!-- TODO: Replace with your actual email -->
      <a
        href="mailto:your.email@example.com"
        class="group flex items-center gap-4 rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] p-5 transition-all hover:border-[var(--accent)] card-hover"
      >
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--accent-muted)]">
          <svg class="h-5 w-5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="font-medium text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">Email</p>
          <p class="text-sm text-[var(--text-secondary)]">your.email@example.com</p>
        </div>
      </a>

      <!-- GitHub -->
      <!-- TODO: Replace with your actual GitHub URL -->
      <a
        href="https://github.com/yourusername"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] p-5 transition-all hover:border-[var(--accent)] card-hover"
      >
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--accent-muted)]">
          <svg class="h-5 w-5 text-[var(--accent)]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <div>
          <p class="font-medium text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">GitHub</p>
          <p class="text-sm text-[var(--text-secondary)]">github.com/yourusername</p>
        </div>
      </a>

      <!-- LinkedIn -->
      <!-- TODO: Replace with your actual LinkedIn URL -->
      <a
        href="https://linkedin.com/in/yourusername"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] p-5 transition-all hover:border-[var(--accent)] card-hover"
      >
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--accent-muted)]">
          <svg class="h-5 w-5 text-[var(--accent)]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </div>
        <div>
          <p class="font-medium text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">LinkedIn</p>
          <p class="text-sm text-[var(--text-secondary)]">linkedin.com/in/yourusername</p>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>
