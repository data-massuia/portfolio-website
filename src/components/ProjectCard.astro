---
/**
 * ProjectCard Component
 *
 * A card that displays a project in the grid on /projects.
 * Shows the project title, description, tech tags, status badge,
 * key learning, and links to demo/repo/writeup.
 */
interface Props {
  title: string;
  description: string;
  tags: string[];
  status: 'completed' | 'in-progress' | 'planned';
  demoUrl?: string;
  repoUrl?: string;
  slug: string;
  keyLearning?: string;
  thumbnail?: string;
}

const { title, description, tags, status, demoUrl, repoUrl, slug, keyLearning, thumbnail } = Astro.props;

// Status badge styling
const statusConfig = {
  'completed': { label: 'Completed', color: 'bg-green-500/20 text-green-400' },
  'in-progress': { label: 'In Progress', color: 'bg-yellow-500/20 text-yellow-400' },
  'planned': { label: 'Planned', color: 'bg-blue-500/20 text-blue-400' },
};

const badge = statusConfig[status];
---

<article class="group flex flex-col rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] overflow-hidden card-hover">
  <!-- Thumbnail / Placeholder -->
  <div class="relative h-44 bg-[var(--bg-tertiary)] flex items-center justify-center overflow-hidden">
    {thumbnail ? (
      <img src={thumbnail} alt={`Screenshot of ${title}`} class="h-full w-full object-cover" />
    ) : (
      <!-- Styled placeholder until a real screenshot is added -->
      <div class="flex flex-col items-center gap-2 text-[var(--text-secondary)]">
        <svg class="h-10 w-10 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        <span class="font-mono text-xs opacity-40">{title}</span>
      </div>
    )}

    <!-- Status Badge -->
    <span class:list={['absolute top-3 right-3 rounded-full px-3 py-1 text-xs font-medium', badge.color]}>
      {badge.label}
    </span>
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-5">
    <h3 class="mb-2 text-lg font-semibold text-[var(--text-heading)] group-hover:text-[var(--accent)] transition-colors">
      <a href={`/projects/${slug}/`}>{title}</a>
    </h3>
    <p class="mb-4 flex-1 text-sm text-[var(--text-secondary)]">{description}</p>

    <!-- Key Learning -->
    {keyLearning && (
      <p class="mb-4 rounded border-l-2 border-[var(--accent)] bg-[var(--accent-muted)] px-3 py-2 text-xs text-[var(--text-secondary)]">
        <span class="font-semibold text-[var(--accent)]">Learned:</span> {keyLearning}
      </p>
    )}

    <!-- Tech Tags -->
    <div class="mb-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full bg-[var(--accent-muted)] px-2 py-0.5 font-mono text-xs text-[var(--accent)]">
          {tag}
        </span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex items-center gap-4 border-t border-[var(--border)] pt-3 text-sm">
      <a
        href={`/projects/${slug}/`}
        class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
      >
        Case Study
      </a>
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
        >
          Live Demo
        </a>
      )}
      {repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
        >
          GitHub
        </a>
      )}
    </div>
  </div>
</article>
