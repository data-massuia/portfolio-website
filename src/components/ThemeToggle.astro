---
/**
 * Theme Toggle Component
 *
 * A button that switches between dark and light mode.
 * Uses localStorage to remember the user's preference and
 * checks the system preference (prefers-color-scheme) on first visit.
 *
 * How it works:
 * - On page load, a script checks localStorage or system preference
 * - Toggles a "light" class on the <html> element
 * - CSS variables in global.css respond to that class
 */
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark/light mode"
  class="relative p-2 rounded-lg transition-colors duration-200 hover:bg-[var(--accent-muted)] cursor-pointer"
>
  <!-- Sun icon (shown in dark mode — click to switch to light) -->
  <svg
    id="sun-icon"
    class="w-5 h-5 text-[var(--text-secondary)] hover:text-[var(--accent)]"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>

  <!-- Moon icon (shown in light mode — click to switch to dark) -->
  <svg
    id="moon-icon"
    class="w-5 h-5 text-[var(--text-secondary)] hover:text-[var(--accent)] hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script>
  // This script runs on every page load to set the correct theme
  function initTheme() {
    const toggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');

    // Check what theme should be active
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isLight = savedTheme === 'light' || (!savedTheme && !prefersDark);

    // Apply the theme
    if (isLight) {
      document.documentElement.classList.add('light');
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    } else {
      document.documentElement.classList.remove('light');
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    }

    // Toggle on click
    toggle?.addEventListener('click', () => {
      const isCurrentlyLight = document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', isCurrentlyLight ? 'light' : 'dark');

      // Swap icons
      sunIcon?.classList.toggle('hidden');
      moonIcon?.classList.toggle('hidden');
    });
  }

  // Run on initial load and on Astro page navigations
  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>
