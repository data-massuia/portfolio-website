---
/**
 * BlogPostCard Component
 *
 * Displays a blog post preview in the list on /blog.
 * Shows the title, date, estimated reading time, tags, and excerpt.
 */
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  tags: string[];
  slug: string;
  /** Raw content body for reading time calculation */
  body?: string;
}

const { title, description, publishDate, tags, slug, body } = Astro.props;

// Format the date for display
const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Estimate reading time (~200 words per minute)
const wordCount = body ? body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<article class="group rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] p-5 card-hover">
  <a href={`/blog/${slug}/`} class="block">
    <!-- Date & Reading Time -->
    <div class="mb-2 flex items-center gap-3 text-sm text-[var(--text-secondary)]">
      <time datetime={publishDate.toISOString()}>{formattedDate}</time>
      <span class="text-[var(--border)]">|</span>
      <span>{readingTime} min read</span>
    </div>

    <!-- Title -->
    <h3 class="mb-2 text-lg font-semibold text-[var(--text-heading)] transition-colors group-hover:text-[var(--accent)]">
      {title}
    </h3>

    <!-- Excerpt -->
    <p class="mb-4 text-sm text-[var(--text-secondary)]">{description}</p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full bg-[var(--accent-muted)] px-2 py-0.5 font-mono text-xs text-[var(--accent)]">
          {tag}
        </span>
      ))}
    </div>
  </a>
</article>
